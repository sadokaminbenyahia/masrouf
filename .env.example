# ─────────────────────────────────────────────────────────────
# Masrouf — variables d'environnement
# Copiez ce fichier en `.env` puis adaptez les valeurs.
# Aucune clé d'API d'IA n'est nécessaire : toute l'IA est locale.
# ─────────────────────────────────────────────────────────────

# Base SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Secret Auth.js (signature des JWT de session). OBLIGATOIRE en production.
# Générez-en un avec : openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-une-chaine-aleatoire-de-32-octets"

# Faire confiance à l'en-tête Host (nécessaire derrière un proxy / en local)
AUTH_TRUST_HOST="true"

# Fuseau horaire utilisé pour « aujourd'hui » (Tunisie : UTC+1, sans heure d'été)
APP_TIMEZONE="Africa/Tunis"

# Rate limiting (fenêtre glissante, en mémoire)
RATE_LIMIT_AUTH_MAX="10"          # tentatives de connexion / inscription par fenêtre
RATE_LIMIT_AUTH_WINDOW_MS="60000"
RATE_LIMIT_AI_MAX="60"            # appels IA par fenêtre et par utilisateur
RATE_LIMIT_AI_WINDOW_MS="60000"

# Affiche les identifiants du compte de démo sur la page de connexion (jamais en production réelle)
MASROUF_DEMO_MODE="true"

# Nombre de proxys de confiance devant l'app (pour lire l'IP client dans X-Forwarded-For).
# 0 = en-tête ignoré (pas de limite par IP) ; 1 = un reverse proxy (nginx, Vercel…).
TRUST_PROXY_HOPS="0"
