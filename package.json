{
  "name": "masrouf",
  "version": "0.1.0",
  "private": true,
  "description": "Masrouf — gestion de budget personnel avec IA 100 % locale",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset --skip-generate && prisma db seed",
    "postinstall": "prisma generate",
    "db:e2e": "node scripts/prepare-e2e-db.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
